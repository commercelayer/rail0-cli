.nh
.TH "RAIL0" "1" "Jul 2026" "rail0 CLI" ""

.SH NAME
rail0-keys-add - Save a signing key in the OS keychain (prompts for the key; names must be unique)


.SH SYNOPSIS
\fBrail0 keys add  [flags]\fP


.SH DESCRIPTION
Save a signing key in the OS keychain (prompts for the key; names must be unique)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for add


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--base-url\fP=""
	RAIL0 gateway base URL (env: RAIL0_BASE_URL)

.PP
\fB--debug\fP[=false]
	Print HTTP request/response details to stderr

.PP
\fB--json\fP[=false]
	Force plain (uncolored) JSON output (useful in scripts)

.PP
\fB--pretty\fP[=false]
	Use the key-value/table view instead of JSON (terminal only)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Print only the result's id/hash, one per line (useful in scripts)


.SH EXAMPLE
.EX
  rail0 keys add payer
.EE


.SH SEE ALSO
\fBrail0-keys(1)\fP
