#!/usr/bin/env bash
# bin/docs — regenerate the CLI reference straight from the Cobra command tree:
# Markdown pages (docs/cli/, for a docs site) and man pages (docs/man/). Run it
# after changing any command, flag, or help text so the docs never drift.
#
#   bin/docs            # write into ./docs
#   bin/docs <outdir>   # write into <outdir>
#
# The generator lives in ./tools/gendocs so its doc deps stay out of the shipped
# `rail0` binary.
set -euo pipefail

# Run from the repo root regardless of the invocation directory.
cd "$(dirname "$0")/.."

OUT="${1:-docs}"

echo "==> generating CLI docs into ${OUT}/"
go run ./tools/gendocs "${OUT}"
echo "==> done: ${OUT}/cli (markdown), ${OUT}/man (man pages)"
