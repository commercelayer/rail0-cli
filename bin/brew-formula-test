#!/bin/sh
# bin/brew-formula-test — build packaging/homebrew/rail0.rb from THIS working tree in a
# throwaway local tap, then run what homebrew-core's CI would: install from source,
# `brew test`, `brew audit --strict`. Uninstalls and untaps on exit, whatever happens.
#
# Needs Homebrew. The formula's url/sha256 point at a release; here they are replaced by
# a tarball of the working tree (git archive HEAD, so commit first), so the formula can
# be tested before the release it will name exists.
set -eu
cd "$(dirname "$0")/.."

tap=local/rail0-formula-test
version=$(cat VERSION)
work=$(mktemp -d)
cleanup() {
  brew uninstall --formula --force "$tap/rail0" >/dev/null 2>&1 || true
  brew untap "$tap" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT INT TERM

tarball="$work/rail0-cli-$version.tar.gz"
git archive --format=tar.gz --prefix="rail0-cli-$version/" -o "$tarball" HEAD
sha=$(shasum -a 256 "$tarball" | cut -d' ' -f1)

brew tap-new --no-git "$tap" >/dev/null
formula="$(brew --repository "$tap")/Formula/rail0.rb"
sed -e "s|^  url \".*\"|  url \"file://$tarball\"|" \
    -e "s|^  sha256 \".*\"|  sha256 \"$sha\"|" \
    packaging/homebrew/rail0.rb > "$formula"

HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_FROM_API=1 brew install --build-from-source --formula "$tap/rail0"
HOMEBREW_NO_AUTO_UPDATE=1 brew test "$tap/rail0"
# --strict without --online: the url is a local file here, which the online checks
# (and the "url must be https" rule) are not meant for.
HOMEBREW_NO_AUTO_UPDATE=1 brew audit --strict --formula "$tap/rail0" || {
  echo "brew audit reported problems (a local file:// url is expected to draw some)" >&2
}
brew style "$formula"
echo "brew-formula-test: OK ($version)"
