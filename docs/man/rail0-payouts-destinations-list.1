.nh
.TH "RAIL0" "1" "Aug 2026" "rail0 CLI" ""

.SH NAME
rail0-payouts-destinations-list - List the account's payout destinations (every wallet's)


.SH SYNOPSIS
\fBrail0 payouts destinations list [flags]\fP


.SH DESCRIPTION
List the account's payout destinations (every wallet's)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--page\fP=0
	Page number (1-based)

.PP
\fB--per-page\fP=0
	Destinations per page

.PP
\fB--sort\fP=""
	Sort fields (e.g. -created_at)

.PP
\fB--status\fP=""
	Filter by status: unverified, verified, disabled

.PP
\fB--wallet\fP=""
	Only this wallet's destinations (wallet id)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--agent\fP[=false]
	Agent mode: one JSON envelope on stdout, JSON events on stderr, no prompts (env: RAIL0_AGENT=1)

.PP
\fB--base-url\fP=""
	RAIL0 gateway base URL (env: RAIL0_BASE_URL)

.PP
\fB--debug\fP[=false]
	Print HTTP request/response details to stderr

.PP
\fB--json\fP[=false]
	Force plain (uncolored) JSON output (useful in scripts)

.PP
\fB--pretty\fP[=false]
	Use the key-value/table view instead of JSON (terminal only)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Print only the result's id/hash, one per line (useful in scripts)


.SH EXAMPLE
.EX
  rail0 payouts destinations list --status verified
  rail0 payouts destinations list --wallet <wallet_id>
.EE


.SH SEE ALSO
\fBrail0-payouts-destinations(1)\fP
