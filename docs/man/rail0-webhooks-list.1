.nh
.TH "RAIL0" "1" "Aug 2026" "rail0 CLI" ""

.SH NAME
rail0-webhooks-list - List webhooks for the authenticated account


.SH SYNOPSIS
\fBrail0 webhooks list [flags]\fP


.SH DESCRIPTION
List webhooks for the authenticated account


.SH OPTIONS
\fB--active\fP=""
	Filter by active flag ('true' or 'false')

.PP
\fB--circuit-state\fP=""
	Filter by circuit state ('closed' or 'open')

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--page\fP=0
	Page number (1-based)

.PP
\fB--per-page\fP=0
	Results per page

.PP
\fB--sort\fP=""
	Sort fields (e.g. -created_at)

.PP
\fB--topic\fP=""
	Filter by topic (e.g. payments.captured)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--base-url\fP=""
	RAIL0 gateway base URL (env: RAIL0_BASE_URL)

.PP
\fB--debug\fP[=false]
	Print HTTP request/response details to stderr

.PP
\fB--json\fP[=false]
	Force plain (uncolored) JSON output (useful in scripts)

.PP
\fB--pretty\fP[=false]
	Use the key-value/table view instead of JSON (terminal only)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Print only the result's id/hash, one per line (useful in scripts)


.SH EXAMPLE
.EX
  rail0 webhooks list --topic payments.captured --active true
.EE


.SH SEE ALSO
\fBrail0-webhooks(1)\fP
