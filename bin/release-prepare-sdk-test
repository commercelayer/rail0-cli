#!/usr/bin/env bash
# bin/release-prepare-sdk-test — the rail0 CLI's own tests for bin/release-prepare: the
# release notes' line for a rail0-go change (sdk_release_note). No network, no GitHub
# sign-in; ci.yml runs it next to bin/release-prepare-test.
#
#   bin/release-prepare-sdk-test
#
# bin/release-prepare-test is shared byte for byte with rail0-ts, rail0-ruby and rail0-go,
# so what only the CLI does (it is the one that requires rail0-go) is tested here.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$ROOT/bin/release-prepare"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/release-prepare-sdk-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

failures=0
pass() { printf 'ok   %s\n' "$1"; }
fail() { printf 'FAIL %s\n' "$1"; failures=$((failures + 1)); }
expect_contains() { # NAME OUTPUT NEEDLE
  case "$2" in *"$3"*) pass "$1" ;; *) fail "$1: expected '$3' in:"; printf '%s\n' "$2" | sed 's/^/     | /' ;; esac
}
expect_absent() {
  case "$2" in *"$3"*) fail "$1: did not expect '$3'" ;; *) pass "$1" ;; esac
}

# `gh` is signed in and lists rail0-go's tags (FAKE_SDK_TAGS); anything else fails, so the
# notes come from git.
mkdir -p "$TMP/stubs"
cat >"$TMP/stubs/gh" <<'EOF'
#!/usr/bin/env bash
case "$1 ${2:-}" in
  "auth status") exit 0 ;;
  "api repos/commercelayer/rail0-go/git/matching-refs/tags/v")
    for t in ${FAKE_SDK_TAGS:-}; do echo "$t"; done ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$TMP/stubs/gh"
export PATH="$TMP/stubs:$PATH"
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
unset RELEASE_PREPARE_SKIP_GIT_CHECKS GH_TOKEN GITHUB_TOKEN 2>/dev/null || true

git init --quiet --bare "$TMP/origin.git"
git clone --quiet "$TMP/origin.git" "$TMP/work" 2>/dev/null
cd "$TMP/work"
git switch --quiet -c main 2>/dev/null || git checkout --quiet -b main
git config commit.gpgsign false
git config tag.gpgsign false
mkdir -p bin
cp "$SCRIPT" bin/release-prepare
echo 1.0.0 >VERSION
gomod() { # RAIL0_GO_VERSION
  printf 'module github.com/rail0/cli\n\ngo 1.26.0\n\nrequire (\n\tgithub.com/commercelayer/rail0-go %s\n)\n' "$1" >go.mod
}
gomod v1.0.0
: >go.sum
git add -A
git commit --quiet -m "initial"
git tag v1.0.0
git push --quiet origin main --tags

run() { "$BASH" bin/release-prepare "$@" </dev/null 2>&1; }
merge_pr() { # NUMBER TITLE [RAIL0_GO_VERSION]  (a pull request; the third moves go.mod)
  git switch --quiet -c "pr-$1"
  if [ -n "${3:-}" ]; then gomod "$3"; git add go.mod; else echo "$1" >>changes.txt; git add changes.txt; fi
  git commit --quiet -m "work for #$1"
  git switch --quiet main
  git merge --quiet --no-ff "pr-$1" -m "Merge pull request #$1 from example/pr-$1" -m "$2"
  git push --quiet origin main
}
notes() { # the dry run's release notes, between the markers
  printf '%s\n' "$1" | awk '/<!-- release-notes:start -->/ { on = 1; next } /<!-- release-notes:end -->/ { on = 0 } on'
}

# --- rail0-go unchanged since the tag: no line ----------------------------------------
merge_pr 10 "fix(keys): a clearer error"
n="$(notes "$(FAKE_SDK_TAGS="refs/tags/v1.0.0" run --dry-run)")"
expect_contains "unchanged rail0-go: the notes are there" "$n" "- **keys:** a clearer error (#10)"
expect_absent "unchanged rail0-go: no deps line" "$n" "rail0-go"

# --- rail0-go moved by a commit whose title does not name it: the line is added -------
# (what the bump offered by a real run leaves on the branch: go.mod moved, no pull request
# saying so)
gomod v1.0.1
git add go.mod && git commit --quiet -m "chore(release): v1.0.1" && git push --quiet origin main
out="$(FAKE_SDK_TAGS="refs/tags/v1.0.0 refs/tags/v1.0.1" run --dry-run)"
n="$(notes "$out")"
expect_contains "moved rail0-go: the deps line" "$n" "- **deps:** rail0-go v1.0.1 (was v1.0.0)"
expect_contains "moved rail0-go: under Changed" "$n" "### Changed"
expect_contains "the other notes stay" "$n" "- **keys:** a clearer error (#10)"
first_changed="$(printf '%s\n' "$n" | awk '/^### Changed$/ { getline; getline; print; exit }')"
[ "$first_changed" = "- **deps:** rail0-go v1.0.1 (was v1.0.0)" ] &&
  pass "the deps line opens Changed" || fail "the deps line opens Changed: got '$first_changed'"
[ "$(printf '%s\n' "$n" | grep -c '^### Changed$')" = 1 ] &&
  pass "one Changed section" || fail "more than one Changed section"
expect_absent "the run's own warning is quiet when go.mod is current" "$out" "but v1.0.1 is released"

# --- a section is added in the right place when Changed was missing -------------------
git reset --quiet --hard v1.0.0 && git push --quiet --force origin main
merge_pr 20 "feat(wallets): list the balances"
merge_pr 21 "fix(api): handle the 404"
gomod v1.0.1
git add go.mod && git commit --quiet -m "chore(release): v1.1.0" && git push --quiet origin main
n="$(notes "$(FAKE_SDK_TAGS="refs/tags/v1.0.1" run --dry-run)")"
order="$(printf '%s\n' "$n" | grep '^### ' | tr '\n' ' ')"
[ "$order" = "### Added ### Changed ### Fixed " ] &&
  pass "Changed between Added and Fixed" || fail "section order: $order"

# --- a pull request that names rail0-go speaks for itself -----------------------------
git reset --quiet --hard v1.0.0 && git push --quiet --force origin main
merge_pr 30 "chore(deps): rail0-go v1.0.1" v1.0.1
n="$(notes "$(FAKE_SDK_TAGS="refs/tags/v1.0.1" run --dry-run)")"
expect_contains "the pull request's own line" "$n" "- **deps:** rail0-go v1.0.1 (#30)"
expect_absent "no second deps line" "$n" "(was v1.0.0)"

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failure(s)"
  exit 1
fi
echo "all release-prepare rail0-go tests passed"
