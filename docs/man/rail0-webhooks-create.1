.nh
.TH "RAIL0" "1" "Jul 2026" "rail0 CLI" ""

.SH NAME
rail0-webhooks-create - Register a new webhook (returns the one-time shared secret)


.SH SYNOPSIS
\fBrail0 webhooks create [flags]\fP


.SH DESCRIPTION
Register a new webhook (returns the one-time shared secret)


.SH OPTIONS
\fB-u\fP, \fB--callback-url\fP=""
	HTTPS endpoint that receives deliveries

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB-n\fP, \fB--name\fP=""
	Human-readable webhook name

.PP
\fB-t\fP, \fB--topic\fP=""
	Topic to subscribe to (e.g. payments.captured)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--base-url\fP=""
	RAIL0 gateway base URL (env: RAIL0_BASE_URL)

.PP
\fB--debug\fP[=false]
	Print HTTP request/response details to stderr

.PP
\fB--json\fP[=false]
	Force plain (uncolored) JSON output (useful in scripts)

.PP
\fB--pretty\fP[=false]
	Use the key-value/table view instead of JSON (terminal only)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Print only the result's id/hash, one per line (useful in scripts)


.SH EXAMPLE
.EX
  rail0 webhooks create --name "capture hook" \\
    --callback-url https://example.com/hook --topic payments.captured
.EE


.SH SEE ALSO
\fBrail0-webhooks(1)\fP
