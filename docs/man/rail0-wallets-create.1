.nh
.TH "RAIL0" "1" "Jul 2026" "rail0 CLI" ""

.SH NAME
rail0-wallets-create - Register a new EVM wallet address on the account


.SH SYNOPSIS
\fBrail0 wallets create [flags]\fP


.SH DESCRIPTION
Register a new EVM wallet address on the account


.SH OPTIONS
\fB-A\fP, \fB--address\fP=""
	EVM wallet address (0x-prefixed hex, or @alias)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB-l\fP, \fB--label\fP=""
	Human-readable wallet label


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--base-url\fP=""
	RAIL0 gateway base URL (env: RAIL0_BASE_URL)

.PP
\fB--debug\fP[=false]
	Print HTTP request/response details to stderr

.PP
\fB--json\fP[=false]
	Force plain (uncolored) JSON output (useful in scripts)

.PP
\fB--pretty\fP[=false]
	Use the key-value/table view instead of JSON (terminal only)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Print only the result's id/hash, one per line (useful in scripts)


.SH EXAMPLE
.EX
  rail0 wallets create --address 0xABCD… --label "Main wallet"
.EE


.SH SEE ALSO
\fBrail0-wallets(1)\fP
